# ── Firebase Client SDK (Public — aman di-expose ke browser) ──────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (RAHASIA — hanya untuk server-side) ────────────
# Dapatkan dari: Firebase Console → Project Settings → Service Accounts
# → Generate new private key → download JSON
# Salin nilai field "project_id" dari JSON:
FIREBASE_ADMIN_PROJECT_ID=

# Salin nilai field "client_email" dari JSON:
FIREBASE_ADMIN_CLIENT_EMAIL=

# Salin nilai field "private_key" dari JSON (termasuk -----BEGIN...END-----)
# PENTING: Ganti setiap newline dalam private key dengan literal \n
# Contoh: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Cloudinary ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
